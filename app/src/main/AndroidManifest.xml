<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Game folders: reading them, and saves when the game folder is chosen -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Auto-updater: download and install Gahvoria's own new versions, always after a tap -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Unpacking a game keeps going in the background, with a progress notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@mipmap/ic_banner"
        android:theme="@style/Gahvoria"
        android:appCategory="game"
        android:isGame="true"
        android:largeHeap="true"
        android:extractNativeLibs="true"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode">
        </activity>

        <!-- Launcher icon in the colors of the "Grafito y coral" palette; only the one for the chosen palette is enabled. -->
        <activity-alias
            android:name=".IconGrafito"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_grafito"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Launcher icon in the colors of the "Medianoche y ámbar" palette; only the one for the chosen palette is enabled. -->
        <activity-alias
            android:name=".IconMedianoche"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_medianoche"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Launcher icon in the colors of the "Esmeralda" palette; only the one for the chosen palette is enabled. -->
        <activity-alias
            android:name=".IconEsmeralda"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_esmeralda"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Launcher icon in the colors of the "Vino y marfil" palette; only the one for the chosen palette is enabled. -->
        <activity-alias
            android:name=".IconVino"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_vino"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Launcher icon in the colors of the "Violeta" palette; only the one for the chosen palette is enabled. -->
        <activity-alias
            android:name=".IconVioleta"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_violeta"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Launcher icon in the colors of the "Océano" palette; only the one for the chosen palette is enabled. -->
        <activity-alias
            android:name=".IconOceano"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_oceano"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Launcher icon in the colors of the "Atardecer" palette; only the one for the chosen palette is enabled. -->
        <activity-alias
            android:name=".IconAtardecer"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_atardecer"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Launcher icon in the colors of the "Menta y crema" palette; only the one for the chosen palette is enabled. -->
        <activity-alias
            android:name=".IconMenta"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_menta"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Launcher icon in the colors of the "Sakura" palette; only the one for the chosen palette is enabled. -->
        <activity-alias
            android:name=".IconSakura"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_sakura"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Launcher icon in the colors of the "Carbón y oro" palette; only the one for the chosen palette is enabled. -->
        <activity-alias
            android:name=".IconCarbon"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_carbon"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Launcher icon in the colors of the "Hielo" palette; only the one for the chosen palette is enabled. -->
        <activity-alias
            android:name=".IconHielo"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_hielo"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- The door for other launchers (Díptico, Daijishō, ES-DE, Cocoon, iiSU...): no screen, starts the game and closes. -->
        <activity
            android:name=".LaunchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.gahvoria" />
                <data android:pathPattern=".*\\..*\\.gahvoria" />
                <data android:pathPattern=".*\\..*\\..*\\.gahvoria" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.InstallService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
